# Supabase (Milestone 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI (Milestone 5)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional. Model used for concept extraction during ingestion.
# Falls back to OPENAI_CHAT_MODEL. Must support Structured Outputs.
OPENAI_CONCEPT_MODEL=
# Optional. Model used for explicit-claim extraction from your own messages.
# Falls back to OPENAI_CHAT_MODEL. Must support Structured Outputs.
OPENAI_CLAIM_MODEL=

# Required by the protected ingestion worker. Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Use one of these to authorize scheduled internal worker calls.
INTERNAL_WORKER_SECRET=
CRON_SECRET=

# Personal Access Token (sbp_...), used ONLY by scripts/apply-migration.mjs.
# Account-scoped, not project-scoped: the service-role key will not work here.
# Create one at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Optional stable deployment key for Next.js Server Actions in multi-instance hosting.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
